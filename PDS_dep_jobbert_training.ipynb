        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "from datasets import Dataset\n",
        "from transformers import (\n",
        "    AutoTokenizer,\n",
        "    AutoModelForSequenceClassification,\n",
        "    TrainingArguments,\n",
        "    Trainer\n",
        ")\n",
        "import evaluate, torch, json\n",
        "from google.colab import drive  # Colab-spezifisch\n",
        "\n",
        "# Drive mounten (einmalig)\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# =========================================================\n",
        "# 1. GEMERGTE CSV laden (FULL Dataset!)\n",
        "# =========================================================\n",
        "train_df = pd.read_csv(\"/content/drive/MyDrive/PDS_Snapaddy/combined_english.csv\")  # Deine gemergte!\n",
        "train_df = train_df[[\"text_en\", \"label\"]].dropna().rename(columns={\"text_en\": \"text\"})\n",
        "\n",
        "# Other entfernen (falls vorhanden)\n",
        "train_df = train_df[train_df[\"label\"] != \"Other\"].reset_index(drop=True)\n",
        "\n",
        "print(\"FULL Train labels (7761 Samples):\\n\", train_df[\"label\"].value_counts())\n",
        "\n",
        "# =========================================================\n",
        "# 2. Weighted Classes (automatisch berechnet!)\n",
        "# =========================================================\n",
        "label_encoder = LabelEncoder()\n",
        "train_df[\"label_id\"] = label_encoder.fit_transform(train_df[\"label\"])\n",
        "num_labels = train_df[\"label_id\"].nunique()\n",
        "\n",
        "# Class weights: Inverse Frequency (sklearn-style)\n",
        "class_counts = train_df[\"label_id\"].value_counts().sort_index()\n",
        "total_samples = len(train_df)\n",
        "class_weights = total_samples / (num_labels * class_counts)\n",
        "class_weights = torch.tensor(class_weights.values, dtype=torch.float).to(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "print(\"Labels:\", list(label_encoder.classes_))\n",
        "print(\"Class Weights:\", class_weights.tolist())\n",
        "\n",
        "# =========================================================\n",
        "# 3. HF-Datasets (FULL → 80/20 Split)\n",
        "# =========================================================\n",
        "def to_hf_dataset(df_, text_col=\"text\", label_col=\"label_id\"):\n",
        "    return Dataset.from_pandas(\n",
        "        df_[[text_col, label_col]].rename(columns={text_col: \"text\", label_col: \"label\"})\n",
        "    )\n",
        "\n",
        "full_dataset = to_hf_dataset(train_df)\n",
        "train_dataset = full_dataset.train_test_split(test_size=0.2, seed=42)[\"train\"]  # 6208 Train\n",
        "val_dataset   = full_dataset.train_test_split(test_size=0.2, seed=42)[\"test\"]   # 1553 Val\n",
        "\n",
        "print(\"Train/Val Split:\", len(train_dataset), len(val_dataset))\n",
        "\n",
        "# =========================================================\n",
        "# 4. Tokenizer & Model\n",
        "# =========================================================\n",
        "MODEL_NAME = \"TechWolf/JobBERT-v3\"\n",
        "\n",
        "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n",
        "\n",
        "def tokenize_function(batch):\n",
        "    return tokenizer(\n",
        "        batch[\"text\"],\n",
        "        padding=\"max_length\",\n",
        "        truncation=True,\n",
        "        max_length=128\n",
        "    )\n",
        "\n",
        "train_dataset = train_dataset.map(tokenize_function, batched=True)\n",
        "val_dataset   = val_dataset.map(tokenize_function, batched=True)\n",
        "\n",
        "cols = [\"input_ids\", \"attention_mask\", \"label\"]\n",
        "train_dataset.set_format(type=\"torch\", columns=cols)\n",
        "val_dataset.set_format(type=\"torch\", columns=cols)\n",
        "\n",
        "model = AutoModelForSequenceClassification.from_pretrained(\n",
        "    MODEL_NAME,\n",
        "    num_labels=num_labels\n",
        ")\n",
        "\n",
        "# =========================================================\n",
        "# 5. Custom Trainer mit Weighted Loss!\n",
        "# =========================================================\n",
        "accuracy = evaluate.load(\"accuracy\")\n",
        "f1 = evaluate.load(\"f1\")\n",
        "\n",
        "def compute_metrics(eval_pred):\n",
        "    logits, labels = eval_pred\n",
        "    preds = np.argmax(logits, axis=-1)\n",
        "    return {\n",
        "        \"accuracy\": accuracy.compute(predictions=preds, references=labels)[\"accuracy\"],\n",
        "        \"f1_macro\": f1.compute(predictions=preds, references=labels, average=\"macro\")[\"f1\"],\n",
        "    }\n",
        "class_weights_global = class_weights\n",
        "\n",
        "class WeightedTrainer(Trainer):\n",
        "    def compute_loss(self, model, inputs, **kwargs):\n",
        "        labels = inputs.pop(\"labels\")\n",
        "        outputs = model(**inputs)\n",
        "        logits = outputs.logits\n",
        "        loss_fct = torch.nn.CrossEntropyLoss(weight=class_weights_global.to(logits.device))\n",
        "        loss = loss_fct(logits.view(-1, logits.shape[-1]), labels.view(-1))\n",
        "        return (loss, outputs) if kwargs.get('return_outputs') else loss\n",
        "\n",
        "save_dir = \"/content/drive/MyDrive/PDS_Snapaddy/models/jobbertv3_department_FULL_weighted\"\n",
        "\n",
        "training_args = TrainingArguments(\n",
        "    output_dir=save_dir,\n",
        "    do_train=True,\n",
        "    do_eval=True,\n",
        "    num_train_epochs=3,\n",
        "    per_device_train_batch_size=8,\n",
        "    per_device_eval_batch_size=16,\n",
        "    learning_rate=2e-5,\n",
        "    weight_decay=0.01,\n",
        "    logging_steps=50,\n",
        "    eval_steps=500,      # Eval alle 500 steps\n",
        "    save_steps=500,      # Save alle 500 steps\n",
        "    eval_strategy=\"steps\",  # ← FIX!\n",
        "    save_strategy=\"steps\",  # ← Match!\n",
        "    fp16=torch.cuda.is_available(),\n",
        "    load_best_model_at_end=True,\n",
        "    metric_for_best_model=\"f1_macro\",\n",
        "    greater_is_better=True,\n",
        ")\n",
        "\n",
        "trainer = WeightedTrainer(\n",
        "    model=model,\n",
        "    args=training_args,  # Mit eval_strategy=\"steps\" fix!\n",
        "    train_dataset=train_dataset,\n",
        "    eval_dataset=val_dataset,\n",
        "    tokenizer=tokenizer,\n",
        "    compute_metrics=compute_metrics,\n",
        ")\n",
        "\n",
        "# =========================================================\n",
        "# 6. Train & Eval\n",
        "# =========================================================\n",
        "trainer.train()\n",
        "metrics_val = trainer.evaluate()\n",
        "print(\"Val-Metriken:\", metrics_val)\n",
        "\n",
        "# =========================================================\n",
        "# 7. Speichern\n",
        "# =========================================================\n",
        "trainer.save_model(save_dir)\n",
        "tokenizer.save_pretrained(save_dir)\n",
        "\n",
        "label_encoder_dict = {\n",
        "    \"classes\": list(label_encoder.classes_),\n",
        "    \"mapping\": {int(i): cls for i, cls in enumerate(label_encoder.classes_)},\n",
        "    \"class_weights\": class_weights.cpu().tolist()  # Weights mit speichern!\n",
        "}\n",
        "with open(f\"{save_dir}/label_encoder.json\", \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(label_encoder_dict, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "print(\"✅ Fertig! FULL Weighted JobBERT in\", save_dir)\n",
        "print(\"Val Accuracy:\", metrics_val[\"eval_accuracy\"])\n",
        "print(\"Val F1-macro:\", metrics_val[\"eval_f1_macro\"])\n"
      ]
    }
  ]
}
